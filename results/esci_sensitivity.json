    "case": "all values lowercased.",
    "punctuation": "non-alphanumeric characters collapsed to spaces (norm()).",
    "missing_facet_value": "an empty product brand/color never matches an emitted value (counts against 'kept'); an empty EMITTED value is not a fire.",
